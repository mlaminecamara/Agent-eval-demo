# Copy to .env and fill in. Never commit .env.

# "mock" runs fully offline (deterministic fake LLM and embeddings). Use "openai" or "anthropic" for real runs.
LLM_PROVIDER=mock
LLM_MODEL=
EMBEDDING_PROVIDER=mock

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# PostgreSQL + pgvector.
# Hosted (real runs): Supabase -> Project Settings -> Database -> Connection string ->
#   "Session pooler" URI, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Local / CI: docker-compose.yml (make up)
DATABASE_URL=postgresql://agent:agent@localhost:5432/agent_eval

# Hard cost guard for one eval run (override config.yaml)
MAX_LLM_CALLS=500
MAX_TOTAL_TOKENS=2000000

# API (make serve / Docker). When API_KEY is set, POST /ask requires the X-API-Key header.
API_KEY=
API_MAX_TOKENS=60000

LOG_LEVEL=INFO
